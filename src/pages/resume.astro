---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const resume = await getEntry("pages", "resume");

if (!resume) {
  throw new Error("Missing content entry: `resume.md` in `src/content/pages/`");
}

const { Content } = await render(resume);
---

<Layout
  title={`${resume.data.title} | ${config.site.title}`}
  description={resume.data.description}
>
  <Header />

  <Breadcrumb />

  <Main pageTitle={resume.data.title} class="app-prose">
    <p class="print:hidden">
      <a href="/resume.pdf" class="hover:text-accent underline decoration-dashed underline-offset-4">PDF 다운로드</a>
    </p>
    <Content />
  </Main>

  <Footer />
</Layout>
